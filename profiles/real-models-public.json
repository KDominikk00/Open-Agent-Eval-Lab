{
  "name": "real-models-public",
  "tasks_dir": "../tasks",
  "output_dir": "../results",
  "split": "public",
  "max_tasks": 8,
  "generate_leaderboard": true,
  "leaderboard_output_dir": "../leaderboard",
  "runs": [
    {
      "agent": "openai-chat",
      "model": "gpt-4o-mini",
      "temperature": 0.0,
      "max_output_tokens": 512,
      "timeout_seconds": 45.0,
      "run_id_prefix": "openai-gpt-4o-mini-public"
    },
    {
      "agent": "anthropic-chat",
      "model": "claude-3-5-haiku-latest",
      "temperature": 0.0,
      "max_output_tokens": 512,
      "timeout_seconds": 45.0,
      "run_id_prefix": "anthropic-haiku-public"
    }
  ]
}
